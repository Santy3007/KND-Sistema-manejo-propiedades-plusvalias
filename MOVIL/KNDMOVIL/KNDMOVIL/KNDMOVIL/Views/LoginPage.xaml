<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KNDMovil.Views.LoginPage"
             BackgroundColor="White"
             Title="Iniciar Sesión">
    <ContentPage.Content>
        <Grid RowSpacing="0">
            <!-- Encabezado con color azul -->
            <Grid.RowDefinitions>
                <RowDefinition Height="150" />
                <RowDefinition Height="*" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <BoxView Grid.Row="0" BackgroundColor="#2196F3" />
            <StackLayout Grid.Row="0" Padding="20" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="KND Inmobiliaria" FontSize="30" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" />
                <Label Text="Iniciar Sesión" FontSize="22" TextColor="White" HorizontalOptions="Center" Margin="0,5,0,0" />
            </StackLayout>

            <!-- Formulario de Login -->
            <Frame Grid.Row="1" Margin="20,20,20,20" Padding="20" CornerRadius="10" BorderColor="#f0f0f0" HasShadow="True">
                <StackLayout Spacing="20">
                    <Frame Padding="15,5" BorderColor="#e0e0e0" CornerRadius="5" HasShadow="False">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="✉️" FontSize="20" VerticalOptions="Center" />
                            <Entry Grid.Column="1" x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" VerticalOptions="Center" />
                        </Grid>
                    </Frame>

                    <Frame Padding="15,5" BorderColor="#e0e0e0" CornerRadius="5" HasShadow="False">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="🔒" FontSize="20" VerticalOptions="Center" />
                            <Entry Grid.Column="1" x:Name="PasswordEntry" Placeholder="Contraseña" IsPassword="True" VerticalOptions="Center" />
                        </Grid>
                    </Frame>

                    <Button x:Name="LoginButton" Text="INICIAR SESIÓN" Clicked="OnLoginButtonClicked" 
                            BackgroundColor="#2196F3" TextColor="White" CornerRadius="5" HeightRequest="50"
                            FontAttributes="Bold" />

                    <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" />
                    <Label x:Name="StatusLabel" TextColor="Red" HorizontalOptions="Center" />
                </StackLayout>
            </Frame>

            
        </Grid>
    </ContentPage.Content>
</ContentPage>